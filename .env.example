# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
# Alternative name (also supported):
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Error monitoring (Sentry) — OPTIONAL but recommended for production.
# Without a DSN, Sentry is disabled and runtime errors are NOT reported anywhere.
# Set this in the Vercel project (Production env) to get notified about crashes.
# VITE_SENTRY_DSN=https://xxxxxxxx@oyyyyyyy.ingest.sentry.io/zzzzzzz

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the values with your actual Supabase project URL and anon/publishable key
# 3. You can find these values in your Supabase project settings > API
# 4. The .env.local file will be ignored by git for security